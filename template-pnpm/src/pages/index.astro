---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import logoNoIconDark from "@/assets/logo-no-icon-dark.png";
import logoNoIconLight from "@/assets/logo-no-icon-light.png";
import heroImage from "@/assets/placeholder-home-hero.png";
import EntryCard from "@/components/blog/EntryCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const featured = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<BaseLayout description="A minimal, use-case-agnostic Astro static site boilerplate.">
  <main id="main">
    <section class="relative overflow-hidden">
      <Image src={heroImage} alt="" class="absolute inset-0 h-full w-full object-cover" widths={[960, 1920]} sizes="100vw" />
      <div class="absolute inset-0 bg-brand-primary dark:bg-brand-quaternary"></div>
      <div class="relative mx-auto max-w-3xl px-6 py-32 max-sm:pt-18 text-center text-brand-quaternary dark:text-brand-primary">
        <Image src={logoNoIconDark} alt="Cosmo" class="mx-auto h-20 w-auto sm:h-24 dark:hidden" />
        <Image src={logoNoIconLight} alt="Cosmo" class="mx-auto h-20 w-auto sm:h-24 hidden dark:block" />
        <p class="mt-6 text-lg text-brand-quaternary/90 dark:text-brand-primary/90 sm:text-xl">
          A minimal, use-case-agnostic Astro static site boilerplate — adapt it into a blog, docs site, landing page, storefront, or portfolio.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a href="https://cosmo.dyslecix.dev/docs/getting-started" target="_blank" rel="noopener noreferrer" class="rounded-md bg-brand-tertiary px-5 py-2.5 text-sm font-semibold text-brand-primary transition hover:bg-brand-quaternary border-2 border-brand-tertiary"
            >Get started</a
          >
          <a
            href="/blog"
            class="rounded-md border border-brand-quaternary/50 dark:border-brand-primary/50 px-5 py-2.5 text-sm font-semibold text-brand-quaternary dark:text-brand-primary transition hover:bg-brand-quaternary/10 dark:hover:bg-brand-primary/10"
            >Read the blog</a
          >
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-24">
      <div class="text-center">
        <h2 class="text-4xl font-bold tracking-tight text-brand-primary dark:text-brand-quaternary">Next Steps</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-brand-secondary dark:text-brand-tertiary">
          Everything you need to adapt cosmo for your project. Every example shipped with cosmo is meant to be renamed or deleted.
        </p>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        <a
          href="https://cosmo.dyslecix.dev/docs/getting-started"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-brand-secondary/40 bg-brand-tertiary bg-linear-to-br from-[#ffd27a] to-transparent p-6 transition duration-500 hover:border-[#ff7a18] hover:bg-[#ffd27a]"
        >
          <h3 class="text-lg font-bold text-brand-primary group-hover:text-[#ff7a18]">Get started</h3>
          <p class="mt-2 text-sm text-brand-secondary">Learn the basics and set up your first page</p>
        </a>
        <a
          href="https://cosmo.dyslecix.dev/docs/rebranding-theme"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-brand-secondary/40 bg-brand-tertiary bg-linear-to-br from-[#f472b6] to-transparent p-6 transition duration-500 hover:border-[#14b8a6] hover:bg-[#f472b6]"
        >
          <h3 class="text-lg font-bold text-brand-primary group-hover:text-[#14b8a6]">Rebrand the theme</h3>
          <p class="mt-2 text-sm text-brand-secondary">Customize colors and design with Tailwind tokens</p>
        </a>
        <a
          href="https://cosmo.dyslecix.dev/docs/managing-content-collections"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-brand-secondary/40 bg-brand-tertiary bg-linear-to-br from-[#f4c47a] to-transparent p-6 transition duration-500 hover:border-[#a86a2e] hover:bg-[#f4c47a]"
        >
          <h3 class="text-lg font-bold text-brand-primary group-hover:text-[#a86a2e]">Manage content collections</h3>
          <p class="mt-2 text-sm text-brand-secondary">Create new content types and organize your data</p>
        </a>
        <a
          href="https://cosmo.dyslecix.dev/docs/wiring-rss"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-brand-secondary/40 bg-brand-tertiary bg-linear-to-br from-[#a78bfa] to-transparent p-6 transition duration-500 hover:border-[#6366f1] hover:bg-[#a78bfa]"
        >
          <h3 class="text-lg font-bold text-brand-primary group-hover:text-[#6366f1]">Wiring RSS</h3>
          <p class="mt-2 text-sm text-brand-secondary">Set up RSS feeds for your blog and content</p>
        </a>
        <a
          href="https://cosmo.dyslecix.dev/docs/seo-checklist"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-brand-secondary/40 bg-brand-tertiary bg-linear-to-br from-[#fbbf24] to-transparent p-6 transition duration-500 hover:border-[#fbbf24] hover:bg-[#fbbf24]"
        >
          <h3 class="text-lg font-bold text-brand-primary group-hover:text-[#a16207]">SEO checklist</h3>
          <p class="mt-2 text-sm text-brand-secondary">Ensure your site is optimized for search engines</p>
        </a>
        <a
          href="https://cosmo.dyslecix.dev/docs/deployment"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-brand-secondary/40 bg-brand-tertiary bg-linear-to-br from-[#94a3b8] to-transparent p-6 transition duration-500 hover:border-[#22d3ee] hover:bg-[#94a3b8]"
        >
          <h3 class="text-lg font-bold text-brand-primary group-hover:text-[#22d3ee]">Deployment</h3>
          <p class="mt-2 text-sm text-brand-secondary">Ship to Cloudflare, GitHub Pages, Netlify, or Vercel</p>
        </a>
        <a
          href="https://cosmo.dyslecix.dev/docs/recommended-integrations"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-brand-secondary/40 bg-brand-tertiary bg-linear-to-br from-[#fee2e2] to-transparent p-6 transition duration-500 hover:border-[#dc2626] hover:bg-[#fee2e2]"
        >
          <h3 class="text-lg font-bold text-brand-primary group-hover:text-[#dc2626]">Recommended integrations</h3>
          <p class="mt-2 text-sm text-brand-secondary">Useful Astro integrations to extend your site</p>
        </a>
        <a
          href="https://cosmo.dyslecix.dev/docs/design-decisions"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-brand-secondary/40 bg-brand-tertiary bg-linear-to-br from-[#d1fae5] to-transparent p-6 transition duration-500 hover:border-[#22c55e] hover:bg-[#d1fae5]"
        >
          <h3 class="text-lg font-bold text-brand-primary group-hover:text-[#22c55e]">Design decisions</h3>
          <p class="mt-2 text-sm text-brand-secondary">Why Cosmo is built the way it is</p>
        </a>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 pb-24">
      <div class="flex items-end justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-brand-primary dark:text-brand-quaternary">Latest from the blog</h2>
        <a href="/blog" class="text-sm font-semibold text-brand-secondary dark:text-brand-tertiary underline hover:no-underline">View all →</a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {featured.map((entry) => <EntryCard entry={entry} />)}
      </div>
    </section>
  </main>
</BaseLayout>
