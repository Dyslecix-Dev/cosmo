---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"blog">;
  headings: MarkdownHeading[];
  minutesToRead: number;
  prev: CollectionEntry<"blog"> | null;
  next: CollectionEntry<"blog"> | null;
  related: CollectionEntry<"blog">[];
}

const { entry, headings, minutesToRead, prev, next, related } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = entry.data;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description}>
  <main class="mx-auto max-w-6xl px-6 py-16">
    <article>
      <header class="mx-auto max-w-2xl">
        <p class="text-xs uppercase tracking-widest text-neutral-500">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span class="mx-2">·</span>
          <span>{minutesToRead} min read</span>
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight">{title}</h1>
        <p class="mt-4 text-lg text-neutral-600">{description}</p>
        {
          updatedDate && (
            <p class="mt-2 text-sm italic text-neutral-500">
              Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </p>
          )
        }
        {
          tags && tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li>
                  <a href={`/blog/tags/${tag}`} class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-700 hover:bg-neutral-200">
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {
        heroImage && (
          /* TODO: replace with real imagery */
          <Image src={heroImage} alt="" class="mx-auto mt-8 aspect-[16/9] w-full max-w-4xl rounded-lg object-cover" widths={[600, 1200]} sizes="(min-width: 1024px) 900px, 100vw" />
        )
      }

      <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <div class="prose mx-auto w-full max-w-2xl lg:mx-0">
          <slot />
        </div>

        {
          tocHeadings.length > 0 && (
            <aside class="order-first lg:order-last">
              <nav class="lg:sticky lg:top-8" aria-label="Table of contents">
                <p class="text-xs font-semibold uppercase tracking-widest text-neutral-500">On this page</p>
                <ol class="mt-3 space-y-2 text-sm">
                  {tocHeadings.map((h) => (
                    <li class={h.depth === 3 ? "pl-4" : ""}>
                      <a href={`#${h.slug}`} class="text-neutral-600 hover:text-neutral-900">
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
          )
        }
      </div>
    </article>

    <nav class="mx-auto mt-16 grid max-w-2xl grid-cols-2 gap-4" aria-label="Post navigation">
      {
        prev ? (
          <a href={`/blog/${prev.id}`} class="rounded-md border border-neutral-200 p-4 hover:border-neutral-300 hover:bg-neutral-50">
            <p class="text-xs uppercase tracking-widest text-neutral-500">← Previous</p>
            <p class="mt-1 font-medium text-neutral-900">{prev.data.title}</p>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/blog/${next.id}`} class="rounded-md border border-neutral-200 p-4 text-right hover:border-neutral-300 hover:bg-neutral-50">
            <p class="text-xs uppercase tracking-widest text-neutral-500">Next →</p>
            <p class="mt-1 font-medium text-neutral-900">{next.data.title}</p>
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    {
      related.length > 0 && (
        <section class="mx-auto mt-16 max-w-4xl">
          <h2 class="text-2xl font-bold tracking-tight">Related posts</h2>
          <ul class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
            {related.map((r) => (
              <li>
                <a href={`/blog/${r.id}`} class="block rounded-md border border-neutral-200 p-4 hover:border-neutral-300 hover:bg-neutral-50">
                  <p class="font-medium text-neutral-900">{r.data.title}</p>
                  <p class="mt-1 text-sm text-neutral-600 line-clamp-2">{r.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>
