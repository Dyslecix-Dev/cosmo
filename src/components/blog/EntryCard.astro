---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { title, description, pubDate, heroImage, tags } = entry.data;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="group flex flex-col overflow-hidden rounded-lg border border-neutral-200 bg-white transition hover:border-neutral-300 hover:shadow-md">
  <a href={`/blog/${entry.id}`} class="flex flex-col h-full">
    {
      heroImage && (
        // TODO: replace with real imagery
        <Image src={heroImage} alt="" class="aspect-[16/9] w-full object-cover" widths={[400, 800]} sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw" />
      )
    }
    <div class="flex flex-1 flex-col p-5">
      <time datetime={pubDate.toISOString()} class="text-xs uppercase tracking-widest text-neutral-500">
        {formattedDate}
      </time>
      <h3 class="mt-2 text-lg font-semibold tracking-tight text-neutral-900 group-hover:underline">
        {title}
      </h3>
      <p class="mt-2 flex-1 text-sm text-neutral-600">{description}</p>
      {
        tags && tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-700">{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</article>
