---
import { getCollection } from "astro:content";

const { pathname } = Astro.url;

const docs = (await getCollection("docs")).filter((entry) => !entry.data.draft);
const sortedDocs = [...docs].sort((a, b) => {
  const aHas = a.data.order !== undefined;
  const bHas = b.data.order !== undefined;
  if (aHas && bHas) return (a.data.order as number) - (b.data.order as number);
  if (aHas) return -1;
  if (bHas) return 1;
  return a.data.title.localeCompare(b.data.title);
});

const isHomeActive = pathname === "/";
const isBlogActive = pathname === "/blog" || pathname.startsWith("/blog/");
const isDocsActive = pathname.startsWith("/docs/");

const linkClass = (active: boolean) => ["rounded-md px-3 py-2 text-sm font-medium transition", active ? "bg-brand-primary text-brand-quaternary" : "text-brand-primary hover:bg-brand-tertiary/25"];
---

<header class="sticky top-0 z-50 w-full bg-brand-quaternary/80 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3" aria-label="Primary">
    <a href="/" class="flex items-center" aria-label="Cosmo home">
      {/* TODO: replace with your brand's logo in public/images/ */}
      <img src="/images/logo-with-icon-light.png" alt="Cosmo" width="1200" height="500" class="h-16 w-auto" />
    </a>

    <ul class="flex items-center gap-1 sm:gap-2">
      <li>
        <a href="/" aria-current={isHomeActive ? "page" : undefined} class:list={linkClass(isHomeActive)}>Home</a>
      </li>
      <li>
        <a href="/blog" aria-current={isBlogActive ? "page" : undefined} class:list={linkClass(isBlogActive)}>Blog</a>
      </li>

      <li class="relative" data-dropdown>
        <button
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="nav-docs-menu"
          data-dropdown-toggle
          class:list={[...linkClass(isDocsActive), "inline-flex items-center gap-1"]}
        >
          Docs
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-4 w-4 transition-transform duration-150 data-[open=true]:rotate-180"
            data-dropdown-chevron
          >
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.39a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
          </svg>
        </button>

        <div
          id="nav-docs-menu"
          role="menu"
          data-dropdown-menu
          class="absolute right-0 mt-2 w-64 origin-top-right rounded-md border border-brand-tertiary/40 bg-brand-quaternary py-1 shadow-lg opacity-0 -translate-y-1 pointer-events-none transition duration-150 ease-out data-[open=true]:opacity-100 data-[open=true]:translate-y-0 data-[open=true]:pointer-events-auto"
        >
          {
            sortedDocs.map((doc) => {
              const href = `/docs/${doc.id}`;
              const isCurrent = pathname === href || pathname === `${href}/`;
              return (
                <a
                  href={href}
                  role="menuitem"
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={["block px-3 py-2 text-sm transition", isCurrent ? "bg-brand-tertiary/25 font-medium text-brand-primary" : "text-brand-primary hover:bg-brand-tertiary/15"]}
                >
                  {doc.data.title}
                </a>
              );
            })
          }
        </div>
      </li>
    </ul>
  </nav>
</header>

<script>
  function setOpen(dropdown: Element, open: boolean) {
    const toggle = dropdown.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
    const menu = dropdown.querySelector<HTMLElement>("[data-dropdown-menu]");
    const chevron = dropdown.querySelector<HTMLElement>("[data-dropdown-chevron]");
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    menu.dataset.open = String(open);
    if (chevron) chevron.dataset.open = String(open);
  }

  function closeAll() {
    for (const dd of document.querySelectorAll("[data-dropdown]")) setOpen(dd, false);
  }

  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    if (!target) return;

    const toggle = target.closest("[data-dropdown-toggle]");
    if (toggle) {
      const dd = toggle.closest("[data-dropdown]");
      if (!dd) return;
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      closeAll();
      if (!isOpen) setOpen(dd, true);
      return;
    }

    if (!target.closest("[data-dropdown]")) closeAll();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeAll();
  });

  // Reset open state across client-side page transitions.
  document.addEventListener("astro:page-load", closeAll);
</script>
