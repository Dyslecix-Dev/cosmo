---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import EntryCard from "@/components/blog/EntryCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection("blog");
  const tags = new Set<string>();
  for (const entry of entries) {
    for (const tag of entry.data.tags ?? []) {
      tags.add(tag);
    }
  }

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: {
      tag,
      entries: entries.filter((entry) => entry.data.tags?.includes(tag)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
};

interface Props {
  tag: string;
  entries: CollectionEntry<"blog">[];
}

const { tag, entries } = Astro.props;
---

<BaseLayout title={`Posts tagged "${tag}"`} description={`Blog posts tagged with ${tag}.`}>
  <main class="mx-auto max-w-6xl px-6 py-16">
    <header class="mb-12">
      <p class="text-sm uppercase tracking-widest text-neutral-500">Tag</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight">{tag}</h1>
      <p class="mt-2 text-neutral-600">
        {entries.length} {entries.length === 1 ? "post" : "posts"}
        · <a href="/blog/tags" class="underline hover:no-underline">All tags</a>
      </p>
    </header>

    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        entries.map((entry) => (
          <li>
            <EntryCard entry={entry} />
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
