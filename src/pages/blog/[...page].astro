---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import EntryCard from "@/components/blog/EntryCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const entries = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(entries, { pageSize: 6 });
};

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

<BaseLayout title="Blog" description="Latest posts from the cosmo example blog.">
  <main class="mx-auto max-w-6xl px-6 py-16">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight">Blog</h1>
      <p class="mt-2 text-neutral-600">Page {page.currentPage} of {page.lastPage}</p>
    </header>

    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        page.data.map((entry) => (
          <li>
            <EntryCard entry={entry} />
          </li>
        ))
      }
    </ul>

    <nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
      <a
        href={page.url.prev}
        class:list={["rounded-md border border-neutral-300 px-4 py-2 text-sm font-medium", page.url.prev ? "text-neutral-900 hover:bg-neutral-50" : "pointer-events-none text-neutral-400"]}
        aria-disabled={!page.url.prev}
      >
        ← Previous
      </a>

      <ol class="flex items-center gap-2">
        {
          Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => {
            const href = n === 1 ? "/blog" : `/blog/${n}`;
            const isCurrent = n === page.currentPage;
            return (
              <li>
                <a
                  href={href}
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={["flex h-9 w-9 items-center justify-center rounded-md text-sm font-medium", isCurrent ? "bg-neutral-900 text-white" : "text-neutral-700 hover:bg-neutral-100"]}
                >
                  {n}
                </a>
              </li>
            );
          })
        }
      </ol>

      <a
        href={page.url.next}
        class:list={["rounded-md border border-neutral-300 px-4 py-2 text-sm font-medium", page.url.next ? "text-neutral-900 hover:bg-neutral-50" : "pointer-events-none text-neutral-400"]}
        aria-disabled={!page.url.next}
      >
        Next →
      </a>
    </nav>
  </main>
</BaseLayout>
