---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import heroImage from "@/assets/placeholder-home-hero.png";
import EntryCard from "@/components/blog/EntryCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const featured = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<BaseLayout description="A minimal, use-case-agnostic Astro static site boilerplate.">
  <main>
    {/* TODO: replace hero copy and imagery for your project */}
    <section class="relative overflow-hidden">
      {/* TODO: replace with real imagery */}
      <Image src={heroImage} alt="" class="absolute inset-0 h-full w-full object-cover" widths={[960, 1920]} sizes="100vw" />
      <div class="absolute inset-0 bg-neutral-900/60"></div>
      <div class="relative mx-auto max-w-3xl px-6 py-32 text-center text-white">
        <h1 class="text-5xl font-bold tracking-tight sm:text-6xl">Cosmo</h1>
        <p class="mt-6 text-lg text-neutral-200 sm:text-xl">A minimal, use-case-agnostic Astro static site boilerplate — adapt it into a blog, docs site, landing page, storefront, or portfolio.</p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a href="/docs/getting-started" class="rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-neutral-900 transition hover:bg-neutral-100">Get started</a>
          <a href="/blog" class="rounded-md border border-white/40 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10">Read the blog</a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-24">
      <div class="text-center">
        <h2 class="text-4xl font-bold tracking-tight text-neutral-900">Next Steps</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600">Everything you need to adapt cosmo for your project. Every example shipped with cosmo is meant to be renamed or deleted.</p>
      </div>
      <div class="mt-12 space-y-6">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <a href="/docs/getting-started" class="group rounded-lg border border-neutral-200 bg-linear-to-br from-blue-50 to-transparent p-6 transition hover:border-blue-300 hover:bg-blue-50">
            <div class="text-3xl">🚀</div>
            <h3 class="mt-3 text-lg font-bold text-neutral-900 group-hover:text-blue-600">Get started</h3>
            <p class="mt-2 text-sm text-neutral-600">Learn the basics and set up your first page</p>
          </a>
          <a href="/docs/rebranding-via-tokens" class="group rounded-lg border border-neutral-200 bg-linear-to-br from-purple-50 to-transparent p-6 transition hover:border-purple-300 hover:bg-purple-50">
            <div class="text-3xl">🎨</div>
            <h3 class="mt-3 text-lg font-bold text-neutral-900 group-hover:text-purple-600">Rebrand via tokens</h3>
            <p class="mt-2 text-sm text-neutral-600">Customize colors and design with Tailwind tokens</p>
          </a>
          <a href="/docs/adding-a-content-collection" class="group rounded-lg border border-neutral-200 bg-linear-to-br from-emerald-50 to-transparent p-6 transition hover:border-emerald-300 hover:bg-emerald-50">
            <div class="text-3xl">📚</div>
            <h3 class="mt-3 text-lg font-bold text-neutral-900 group-hover:text-emerald-600">Add a collection</h3>
            <p class="mt-2 text-sm text-neutral-600">Create new content types and organize your data</p>
          </a>
        </div>
        <div class="flex flex-col gap-6 md:flex-row md:justify-center">
          <a href="/docs/wiring-rss" class="group rounded-lg border border-neutral-200 bg-linear-to-br from-orange-50 to-transparent p-6 transition hover:border-orange-300 hover:bg-orange-50 md:w-1/3">
            <div class="text-3xl">📡</div>
            <h3 class="mt-3 text-lg font-bold text-neutral-900 group-hover:text-orange-600">Writing RSS</h3>
            <p class="mt-2 text-sm text-neutral-600">Set up RSS feeds for your blog and content</p>
          </a>
          <a href="/docs/seo-checklist" class="group rounded-lg border border-neutral-200 bg-linear-to-br from-rose-50 to-transparent p-6 transition hover:border-rose-300 hover:bg-rose-50 md:w-1/3">
            <div class="text-3xl">✅</div>
            <h3 class="mt-3 text-lg font-bold text-neutral-900 group-hover:text-rose-600">SEO checklist</h3>
            <p class="mt-2 text-sm text-neutral-600">Ensure your site is optimized for search engines</p>
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 pb-24">
      <div class="flex items-end justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900">Latest from the blog</h2>
        <a href="/blog" class="text-sm font-semibold text-neutral-700 underline hover:no-underline">View all →</a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {featured.map((entry) => <EntryCard entry={entry} />)}
      </div>
    </section>
  </main>
</BaseLayout>
